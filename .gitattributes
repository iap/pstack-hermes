# The package enforces LF-only text (validate.py fails on any CRLF/BOM);
# keep the working copy byte-identical to the converter output.
* text=auto eol=lf

# `pstack/` is converter output (CONTRIBUTING.md, "Repository contract").
# Mark it generated so GitHub collapses its diffs and excludes it from
# language stats: review it as build output, not as hand-written code.
pstack/** linguist-generated=true
